---
import './skeleton.css';

interface Props {
  pType?: 'line' | 'box';
  pClass?: string;
}

const { pType = 'line', pClass, ...attrs } = Astro.props;
const classes = ['skeleton', pType, pClass].filter(Boolean).join(' ');
---

<div role="status" class={classes} aria-label="Loading…" {...attrs} />
