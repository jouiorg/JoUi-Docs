---
import './spinner.css';

interface Props {
  pSize?: 'small' | 'medium' | 'large';
  pOverlay?: boolean;
  pLabel?: string;
  pClass?: string;
}

const { pSize = 'medium', pOverlay = false, pLabel = 'Loading…', pClass, ...attrs } = Astro.props;

const spinnerParts = [pSize !== 'medium' ? pSize : '', pOverlay ? 'overlay' : ''].filter(Boolean).join(' ') || undefined;
---

<div
  aria-busy="true"
  aria-label={pLabel}
  data-spinner={spinnerParts}
  class={pClass}
  {...attrs}
>
  <slot />
</div>
