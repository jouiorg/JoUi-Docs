---
import './button.css';

interface Props {
  pVariant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  pSize?: 'sm' | 'md' | 'lg';
  pDisabled?: boolean;
  pHref?: string;
  pType?: 'button' | 'submit' | 'reset';
  pClass?: string;
}

const {
  pVariant = 'primary',
  pSize = 'md',
  pDisabled = false,
  pHref,
  pType = 'button',
  pClass,
  ...attrs
} = Astro.props;

const classes = ['btn', `btn--${pVariant}`, `btn--${pSize}`, pClass].filter(Boolean).join(' ');
const Tag = pHref ? 'a' : 'button';
---

<Tag
  class={classes}
  href={pHref}
  type={!pHref ? pType : undefined}
  disabled={!pHref ? pDisabled : undefined}
  aria-disabled={pHref && pDisabled ? 'true' : undefined}
  {...attrs}
>
  <slot />
</Tag>
