---
import './badge.css';

interface Props {
  pVariant?: 'default' | 'secondary' | 'outline' | 'success' | 'warning' | 'danger';
  pClass?: string;
}

const { pVariant = 'default', pClass, ...attrs } = Astro.props;

const isOutline   = pVariant === 'outline';
const dataVariant = pVariant !== 'default' && pVariant !== 'outline' ? pVariant : undefined;
const classes     = ['badge', isOutline ? 'outline' : '', pClass].filter(Boolean).join(' ');
---

<span class={classes} data-variant={dataVariant} {...attrs}>
  <slot />
</span>
