---
import './avatar.css';

interface Props {
  pSrc?: string;
  pAlt?: string;
  pInitials?: string;
  pSize?: 'small' | 'medium' | 'large';
  pClass?: string;
}

const { pSrc, pAlt = '', pInitials, pSize = 'medium', pClass, ...attrs } = Astro.props;
const classes = [pSize !== 'medium' ? pSize : '', pClass].filter(Boolean).join(' ') || undefined;
---

<figure data-variant="avatar" class={classes} {...attrs}>
  {pSrc ? <img src={pSrc} alt={pAlt} /> : pInitials}
</figure>
