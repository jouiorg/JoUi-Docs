---
import Layout from './Layout.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/utils';

interface Props {
  title?: string;
  locale?: Locale;
}

const { title, locale = 'en' } = Astro.props;
const t = useTranslations(locale);
const path = Astro.url.pathname;

const isActive = (href: string) => path === href || path.startsWith(href + '/');

const sectionOrder = [
  'gettingStarted',
  'primitives',
  'content',
  'feedback',
  'navigation',
  'forms',
  'dataDisplay',
  'layout',
  'overlays',
  'advanced',
] as const;

type SectionKey = typeof sectionOrder[number];

const allDocs = await getCollection('docs');

const grouped = new Map<SectionKey, { label: string; href: string; order: number }[]>();

// Introduction is a static page not in the collection
grouped.set('gettingStarted', [{ label: t('docs.introduction'), href: '/docs', order: 0 }]);

for (const entry of allDocs) {
  const { section, order, title: label } = entry.data;
  if (!section) continue;
  const key = section as SectionKey;
  if (!grouped.has(key)) grouped.set(key, []);
  grouped.get(key)!.push({ label, href: `/docs/${entry.id}`, order: order ?? 99 });
}

for (const items of grouped.values()) {
  items.sort((a, b) => a.order - b.order);
}

const nav = sectionOrder
  .filter(s => grouped.has(s))
  .map(s => ({ label: t(`sidebar.${s}`), items: grouped.get(s)! }));

const pageTitle = title ? `${title} — joui` : 'joui — Component Library';
---

<Layout title={pageTitle} lang={locale}>
  <nav class="docs-topnav">
    <button
      class="docs-icon-btn docs-menu-btn"
      aria-label={t('nav.toggleMenu')}
      data-docs-menu-toggle
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
    </button>

    <a href="/" class="docs-brand">joui</a>

    <div class="docs-topnav-end">
      <a href="/docs" class="docs-topnav-link">{t('nav.docs')}</a>
      <a
        href="https://github.com/jouiorg/JoUi-Docs"
        class="docs-topnav-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t('nav.github')}
      </a>

      <button
        class="docs-icon-btn"
        aria-label={t('nav.toggleTheme')}
        data-theme-toggle
      >
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
    </div>
  </nav>

  <div class="docs-body" id="docs-body">
    <aside class="docs-sidebar" id="docs-sidebar">
      {nav.map(section => (
        <div class="docs-sidebar-section">
          <p class="docs-sidebar-title">{section.label}</p>
          <ul class="docs-sidebar-list">
            {section.items.map(item => (
              <li>
                <a
                  href={item.href}
                  class="docs-sidebar-link"
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </aside>

    <main class="docs-main">
      <slot />
    </main>
  </div>
</Layout>

<script>
  // Sidebar toggle (mobile)
  const menuBtn = document.querySelector('[data-docs-menu-toggle]');
  const body    = document.getElementById('docs-body');
  menuBtn?.addEventListener('click', () => body?.toggleAttribute('data-sidebar-open'));

  // Close sidebar when clicking outside (mobile)
  document.addEventListener('click', e => {
    const target = e.target as HTMLElement;
    if (!target.closest('#docs-sidebar') && !target.closest('[data-docs-menu-toggle]')) {
      body?.removeAttribute('data-sidebar-open');
    }
  });

  // Theme toggle
  const themeBtn = document.querySelector('[data-theme-toggle]');
  const iconSun  = themeBtn?.querySelector('.icon-sun') as HTMLElement | null;
  const iconMoon = themeBtn?.querySelector('.icon-moon') as HTMLElement | null;

  const applyTheme = (theme: string) => {
    document.documentElement.setAttribute('data-theme', theme);
    if (iconSun && iconMoon) {
      iconSun.style.display  = theme === 'dark' ? 'none' : '';
      iconMoon.style.display = theme === 'dark' ? '' : 'none';
    }
  };

  // Sync icon with current theme on load
  applyTheme(document.documentElement.getAttribute('data-theme') || 'light');

  themeBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    const next = isDark ? 'light' : 'dark';
    applyTheme(next);
    localStorage.setItem('joui-theme', next);
  });
</script>
