---
import './alert.css';

interface Props {
  pVariant?: 'default' | 'success' | 'warning' | 'danger' | 'error';
  pClass?: string;
}

const { pVariant = 'default', pClass, ...attrs } = Astro.props;
const dataVariant = pVariant !== 'default' ? pVariant : undefined;
---

<div role="alert" class={pClass} data-variant={dataVariant} {...attrs}>
  <slot />
</div>
