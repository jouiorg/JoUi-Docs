---
import './accordion.css';

interface Props {
  pSummary: string;
  pName?: string;
  pOpen?: boolean;
  pClass?: string;
}

const { pSummary, pName, pOpen = false, pClass, ...attrs } = Astro.props;
---

<details name={pName} open={pOpen} class={pClass} {...attrs}>
  <summary>{pSummary}</summary>
  <slot />
</details>
